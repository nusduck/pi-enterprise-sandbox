#!/bin/sh
set -eu

# Accept the old "wrapper <baseDir>/scripts/main.ts ..." shape as well as the
# documented wrapper-only form, so cached prompts remain compatible.
case "${1:-}" in
  */baoyu-markdown-to-html/scripts/main.ts)
    shift
    ;;
esac

exec /usr/local/bin/bun \
  /usr/local/lib/pi-skill-runtime/baoyu-markdown-to-html/main.ts "$@"
