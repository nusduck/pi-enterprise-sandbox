#!/bin/sh
set -eu

# Chromium's Debian launcher reads /etc/chromium.d/*, but the production
# Bubblewrap child intentionally exposes only a small /etc allowlist.  Invoke
# the packaged binary directly and keep Bubblewrap as the outer sandbox.
exec /usr/lib/chromium/chromium \
  --no-sandbox \
  --disable-dev-shm-usage \
  "$@"
