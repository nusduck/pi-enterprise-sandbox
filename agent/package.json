{
  "name": "pi-enterprise-agent",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:http": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch server.js",
    "dev:worker": "tsx watch worker.js",
    "test": "npm run build && tsx --test tests/*.test.js tests/**/*.test.js tests/**/*.test.ts",
    "test:mysql:unit": "node --test tests/mysql/*.unit.test.js",
    "test:mysql:integration": "node --test tests/mysql/*.integration.test.js",
    "test:mysql": "node --test tests/mysql/**/*.test.js tests/mysql/*.test.js",
    "test:redis:unit": "node --test tests/redis/*.unit.test.js",
    "test:redis:integration": "node --test tests/redis/*.integration.test.js",
    "test:redis": "node --test tests/redis/**/*.test.js tests/redis/*.test.js",
    "test:run-services": "node --test tests/run-services/**/*.test.js",
    "test:t4": "node --test tests/http/**/*.test.js tests/bootstrap/**/*.test.js",
    "test:a2a": "node --test tests/a2a/**/*.test.js tests/a2a/*.test.js",
    "test:pr14": "node --test tests/pr14/**/*.test.js tests/pr14/*.test.js",
    "migrate:latest": "tsx src/infrastructure/mysql/cli-migrate.ts latest",
    "migrate:rollback": "tsx src/infrastructure/mysql/cli-migrate.ts rollback",
    "migrate:rollback-all": "tsx src/infrastructure/mysql/cli-migrate.ts rollback-all",
    "migrate:status": "tsx src/infrastructure/mysql/cli-migrate.ts status",
    "smoke": "node --test tests/listen-smoke.test.js tests/fake-openai-provider.test.js",
    "build": "tsc -p tsconfig.build.json && npm run build:bundle",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
    "gen:patch": "tsx scripts/gen-patch.ts",
    "build:bundle": "mkdir -p dist/src/runtime/bundle && cp src/runtime/bundle/*.yml dist/src/runtime/bundle/"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-base": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pi/contract": "file:../contract",
    "bullmq": "^5.80.2",
    "ioredis": "^5.10.1",
    "jiti": "2.6.1",
    "knex": "^3.1.0",
    "mysql2": "3.15.3",
    "node-addon-require-builtin": "0.1.4",
    "yaml": "2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/src/runtime/bundle/cordis.patch.yml"
    }
  }
}
