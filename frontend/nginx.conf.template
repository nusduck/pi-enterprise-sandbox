# Rendered at container start by nginx:alpine's envsubst entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh). Only the variables listed
# in NGINX_ENVSUBST_FILTER are substituted, so nginx's own $host / $remote_addr
# survive untouched.
#
#   BFF_UPSTREAM  api-server host:port          (default api-server:4000)
#   DNS_RESOLVER  resolver address for that name (default kube-dns)

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Align with product limits: 50MB file + multipart overhead (BFF 55MB).
    # Nginx default is 1m, which rejects normal attachments with HTTP 413.
    client_max_body_size 55m;
    client_body_timeout 300s;

    # Probe endpoint. Served locally so it reports *this* replica's health and
    # never depends on the BFF being reachable.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # API proxy to backend
    location /api/ {
        # nginx resolves a literal upstream name once, at startup, and caches
        # the address forever. In Kubernetes that outlives the Service it
        # resolved. Naming the resolver and passing the upstream through a
        # variable forces re-resolution on the configured validity window.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $bff_upstream ${BFF_UPSTREAM};
        proxy_pass http://$bff_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;  # Required for SSE
        proxy_cache off;
        # Stream large multipart uploads to the BFF without full buffering.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
