# /etc/dsh-exec/exec.env —— dsh-exec.service 的 EnvironmentFile。
# 权限 root:dsh-exec 0640。本文件只允许占位符；真实值由部署填写，不入库。
# 只列 exec 代码实际读取的变量（tests/test_vm_release_assets.py 核对）。

DEPLOYMENT_ENV=production
EXEC_PORT=8081
# 单 VM 单实例（WorkspaceLock 只在进程内）。
EXEC_CONCURRENCY=1

# ── UPDRDB：连接串不带口令，口令启动时向 DBPM 取（ADR 0011 D10）──
EXEC_DATABASE_URL=mysql://<app-user>@<updrdb-host>:3306/<database>
UPDRDB_ENDPOINTS=<proxy-a-host>:<port>,<proxy-b-host>:<port>
DBPM_URL=<dbpm-a-host>:<port>,<dbpm-b-host>:<port>
DBPM_DB_NAME=<dbpm-entry-name>
DBPM_DB_USER_NAME=<app-user>

# ── 服务间凭据（与 agent / BFF / sandbox-mcp 对应值一致）──
SANDBOX_INTERNAL_HMAC_KEYRING=<json-keyring>
SANDBOX_INTERNAL_HMAC_ACTIVE_KID=<kid>
SANDBOX_API_TOKEN=<service-token>
SANDBOX_MCP_INTERNAL_TOKEN=<narrow-bridge-token>
# 内部面来源白名单：按实测的 LB SNAT / 源地址保留方式填写（design §2.2），不要照抄 Pod CIDR。
# exec 对空值拒绝全部内部面请求；exec-preflight.sh 另外要求非空，避免服务起来却全部 403。
EXEC_INTERNAL_ALLOW_CIDR=<cidr>[,<cidr>]

# ── 本地数据根（install-release.sh init 建出，属主 dsh-exec，0700）──
SANDBOX_WORKSPACES_ROOT=/var/lib/dsh-exec/workspaces
SANDBOX_TEMP_ROOT=/var/lib/dsh-exec/tmp
SANDBOX_ARTIFACTS_ROOT=/var/lib/dsh-exec/artifacts
SANDBOX_CONTROL_ROOT=/var/lib/dsh-exec/control

# ── 共享 Skill 存储（design §3.1；挂载点由存储联调确定）──
SANDBOX_SKILLS_ROOT=/mnt/dsh-skill/system/<skill-release-id>
SANDBOX_USER_SKILLS_ROOT=/mnt/dsh-skill/published
SANDBOX_SKILL_DRAFT_ROOT=/mnt/dsh-skill/draft

SANDBOX_BWRAP_PATH=/usr/bin/bwrap

# 可选：工作区配额（默认值见 exec/src/workspace/env-config.ts）。
# SANDBOX_WORKSPACE_QUOTA_MB=500
# SANDBOX_TEMP_QUOTA_MB=500
# SANDBOX_WORKSPACE_CHILD_QUOTA_ENFORCEMENT=true
# SANDBOX_WORKSPACE_QUOTA_HARD_BACKEND_ASSERTED=false

# 可选：数据源目录（docs/design/sandbox-data-sources.md）。口令由 exec 启动时向 DBPM 取，
# 这里只写地址、库名、DBPM 条目与只读账号；防火墙放行 exec → 各 endpoint。Agent 侧同一份。
# SANDBOX_DATA_SOURCES_JSON=[{"id":"<id>","label":"<名称>","endpoint":"<db-host>:3306","database":"<database>","dbpmDbName":"<dbpm-entry>","userName":"<readonly-user>"}]

# 可选：注入到每次执行子进程的环境（逗号分隔的键名，或 SANDBOX_EXEC_ENV_<NAME>=value）。
# SANDBOX_SHARED_ENV_KEYS=
# EXEC_HTTP_LOG=1

LANG=C.UTF-8
LC_ALL=C.UTF-8
